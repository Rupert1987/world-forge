{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "rm -rf .test-build && esbuild src/lib/*.test.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --external:*.node --external:sharp --external:@huggingface/transformers --external:@techstark/opencv-js --outdir=.test-build && NODE_PATH=$PWD/node_modules node --test .test-build/*.test.cjs; status=$?; rm -rf .test-build; exit $status",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@huggingface/transformers": "^4.2.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jpeg-js": "^0.4.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
